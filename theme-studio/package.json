{
  "name": "clockwise-theme-studio",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "embed": "node native/embed.mjs",
    "build:apps": "node tools/build-theme-apps.mjs",
    "build": "python native/build.py && node native/embed.mjs",
    "check:gallery": "node tools/check-gallery.mjs",
    "build:native": "python native/build.py",
    "test:native": "node --test tests/native-package.test.mjs && python native/tests/check.py"
  },
  "dependencies": {
    "fengari-web": "0.1.4",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
