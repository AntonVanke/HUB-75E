{
  "packageName": "org.clockwise.ambient-clock",
  "id": "ambient-clock",
  "title": "炫彩氛围时钟",
  "appVersion": "1.0.0",
  "description": "柔和流动的色盘、连续渐变与前景基础时钟；静态空间抖动减少 RGB565 色带，无逐帧分配。",
  "author": "HUB-75E",
  "requirements": {"targetFps": 120, "stateBytes": 2048, "graphicsBytes": 8192},
  "parameters": {
    "speed": {"label":"流动速度 / Speed","min":0.1,"max":3,"step":0.1,"default":1},
    "saturation": {"label":"饱和度 / Saturation","min":20,"max":100,"step":1,"default":80},
    "level": {"label":"背景亮度 / Light","min":10,"max":100,"step":1,"default":65},
    "clock": {"label":"时钟 / Clock","min":0,"max":1,"step":1,"default":1}
  }
}
