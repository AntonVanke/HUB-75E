{
  "packageName": "org.clockwise.gravity-liquid",
  "id": "gravity-liquid",
  "title": "全屏重力水",
  "appVersion": "1.2.0",
  "description": "原生 C++ 水模拟，从顶部注水 2 秒，水量最高 70%，前景时钟，S3 目标 120 FPS。",
  "author": "HUB-75E",
  "requirements": {
    "sensors": [
      "imu"
    ],
    "targetFps": 120,
    "stateBytes": 16,
    "graphicsBytes": 40960
  },
  "parameters": {
    "fill": {
      "label": "水量 / Fill",
      "min": 10,
      "max": 70,
      "step": 1,
      "default": 46
    },
    "gravity": {
      "label": "重力 / Gravity",
      "min": 1,
      "max": 15,
      "step": 0.1,
      "default": 9.8
    },
    "drops": {
      "label": "水滴上限 / Droplets",
      "min": 0,
      "max": 128,
      "step": 1,
      "default": 96
    },
    "viscosity": {
      "label": "粘度 / Viscosity",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    "speed": {
      "label": "速度 / Speed",
      "min": 0.3,
      "max": 1,
      "step": 0.05,
      "default": 0.88
    },
    "clock": {
      "label": "时钟 / Clock",
      "min": 0,
      "max": 1,
      "step": 1,
      "default": 1
    }
  }
}
