{
  "id": "gravity-hourglass",
  "packageName": "org.clockwise.gravity-hourglass",
  "title": "重力沙漏",
  "appVersion": "2.1.0",
  "description": "重力沙漏：沙粒和边框颜色独立可调，1/2 像素沙粒，双菱形或全屏双三角；A 复位、B 暂停。目标 120 FPS，非校准计时器。",
  "author": "AntonVanke / HUB-75E",
  "category": "重力互动",
  "width": 64,
  "height": 64,
  "resources": {},
  "requirements": {
    "chips": [
      "esp32s3"
    ],
    "psramBytes": 0,
    "stateBytes": 21504,
    "graphicsBytes": 8192,
    "targetFps": 120,
    "sensors": [
      "imu"
    ]
  },
  "verification": {
    "status": "unverified"
  },
  "parameters": {
    "seconds": {
      "label": "流沙时长 / Duration (s)",
      "min": 5,
      "max": 600,
      "step": 5,
      "default": 60
    },
    "sandColor": {
      "label": "沙粒颜色 / Sand",
      "type": "color",
      "min": 0,
      "max": 16777215,
      "step": 1,
      "default": 16777215
    },
    "borderColor": {
      "label": "边框颜色 / Border",
      "type": "color",
      "min": 0,
      "max": 16777215,
      "step": 1,
      "default": 6583435
    },
    "grainSize": {
      "label": "沙粒大小 / Grain size",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "options": {
        "1": "1 像素 / 1 pixel",
        "2": "2 像素 / 2 pixels"
      }
    },
    "shape": {
      "label": "沙漏形状 / Shape",
      "min": 0,
      "max": 1,
      "step": 1,
      "default": 0,
      "options": {
        "0": "双菱形 / Diamonds",
        "1": "全屏双三角 / Full triangles"
      }
    }
  }
}
