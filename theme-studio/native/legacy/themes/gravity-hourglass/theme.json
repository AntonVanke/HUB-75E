{
  "id": "gravity-hourglass",
  "packageName": "org.clockwise.gravity-hourglass",
  "title": "重力沙漏",
  "appVersion": "2.0.0",
  "description": "双菱形 LED 重力沙漏，64 粒白色光点随倾斜堆积、翻转回流；A 复位、B 暂停，流沙时长可调。目标 120 FPS，非校准计时器。",
  "author": "AntonVanke / HUB-75E",
  "category": "重力互动",
  "width": 64,
  "height": 64,
  "resources": {},
  "requirements": {
    "chips": [
      "esp32s3"
    ],
    "psramBytes": 0,
    "stateBytes": 512,
    "graphicsBytes": 8192,
    "targetFps": 120,
    "sensors": [
      "imu"
    ]
  },
  "verification": {
    "status": "unverified"
  },
  "parameters": {
    "seconds": {
      "label": "流沙时长 / Duration (s)",
      "min": 5,
      "max": 600,
      "step": 5,
      "default": 60
    }
  }
}
